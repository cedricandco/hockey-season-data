<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HockeySeason.Application\HockeySeason.Application.csproj" />
    <ProjectReference Include="..\HockeySeason.Domain\HockeySeason.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft Agent Framework: agent abstractions and ChatClientAgent. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="1.28.0" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" Version="1.28.0-preview.261106.1" />
    <!-- Ollama client implementing Microsoft.Extensions.AI IChatClient. -->
    <PackageReference Include="OllamaSharp" Version="5.5.2" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
  </ItemGroup>

  <!-- Ship the agent instruction file next to the binaries so it can be
       overridden per environment (content root) without a rebuild. -->
  <ItemGroup>
    <None Include="Agents\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
